# =============================================================================
# VPC 模块 —— 网络基础设施
# =============================================================================
# VPC（Virtual Private Cloud）是 AWS 云中的虚拟私有网络。
# 可以把 VPC 理解为：在 AWS 数据中心里给你划了一块"局域网"。
#
# 本模块创建的网络拓扑：
#
#   Internet ─── Internet Gateway ─── 公有子网 (10.0.1.0/24)
#                                        │
#                                        ├── EC2 安全组
#                                        │   - 允许 HTTPS 443 (全网)
#                                        │   - 允许 SSH 22 (仅管理员 IP)
#                                        │   - 允许所有出站
#                                        │
#                                        └── EC2 实例
#                                             │
#                                             └── 访问 ──→ 私有子网 (10.0.2.0/24)
#                                                              │
#                                                              └── RDS 安全组
#                                                                  - 允许 5432 (仅 EC2 安全组)
#
# 关键概念：
#   - CIDR: IP 段表示法。10.0.0.0/16 = 10.0.0.0 ~ 10.0.255.255（65536 个 IP）
#   - 子网: VPC 的 IP 段子集。每个子网绑定一个可用区（AZ）
#   - Internet Gateway: VPC 访问互联网的"网关"，没有它 VPC 就是内网
#   - 路由表: 决定网络流量怎么走（类似路由器）
#   - 安全组: 虚拟防火墙，控制进/出流量（stateful——允许进就自动允许出）
#
# 公有子网 vs 私有子网的本质区别：
#   路由表中是否有指向 Internet Gateway 的 0.0.0.0/0 路由
# =============================================================================

# =============================================================================
# VPC —— 虚拟私有云
# =============================================================================
# VPC 是所有网络资源的最外层容器。
#
# CIDR 选择建议：
#   - 10.0.0.0/16: 最常用，65536 个 IP，小项目用不完但灵活
#   - 172.16.0.0/12: 中等规模
#   - 192.168.0.0/16: 兼容传统局域网（不推荐——和家庭网络可能冲突）
# =============================================================================
# =============================================================================
# Terraform 语法速查：resource 的语法含义
# =============================================================================
# resource "<资源类型>" "<本地名称>" { ... }
#   - "资源类型"（如 aws_vpc）：由 Provider 定义，告诉 Terraform「我要创建什么」。
#     命名规范：<provider>_<资源名>
#   - "本地名称"（如 main）：你自己起的名字，只在当前模块内有效，
#     用于在代码中引用这个资源，如 aws_vpc.main.id
#   - 类比 Java：AwsVpc main = new AwsVpc();
#     资源类型 ≈ 类名，本地名称 ≈ 变量名
# =============================================================================
resource "aws_vpc" "main" {
  cidr_block           = "10.0.0.0/16"          # VPC 总 IP 段
  enable_dns_hostnames = true                    # 为 EC2 分配公共 DNS 主机名
  enable_dns_support   = true                    # 启用 DNS 解析（RDS 需要）
  tags = { Name = "smart-invest-vpc" }
}

# =============================================================================
# 公有子网 —— 可直接访问互联网的子网
# =============================================================================
# 放在公有子网的资源可以获得公网 IP，能直接被互联网访问。
# 适合放：EC2（Web 服务器）、负载均衡器、NAT Gateway、Bastion Host
#
# map_public_ip_on_launch = true:
#   这个子网内启动的 EC2 会自动获得一个公网 IP。
#   注意：停止再启动后公网 IP 会变！固定 IP 需要用 EIP（弹性 IP）。
# =============================================================================
resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = "10.0.1.0/24"        # 公有子网 IP 段（256 个 IP）
  availability_zone       = "${var.region}a"      # 可用区 = 地区 + a/b/c
  map_public_ip_on_launch = true                  # 自动分配公网 IP
  tags = { Name = "smart-invest-public" }
}

# =============================================================================
# 私有子网 —— 不直接暴露互联网的子网
# =============================================================================
# 放在私有子网的资源没有公网 IP，只能从 VPC 内部访问。
# 适合放：数据库、缓存、内部微服务（安全敏感的资源）
#
# 如果需要访问外网（如下载软件包），私有子网的实例可以通过 NAT Gateway
# （放在公有子网）访问互联网，但互联网无法主动访问私有子网。
#
# 注意：这个项目为了简单，RDS 使用的是 VPC 安全组限制而非严格的私有子网。
# 生产环境应该把 RDS 放在私有子网，EC2 放在公有子网。
# =============================================================================
resource "aws_subnet" "private" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = "10.0.2.0/24"              # 私有子网 IP 段（256 个 IP）
  availability_zone = "${var.region}a"            # 和公有子网同一个 AZ，降低延迟
  tags = { Name = "smart-invest-private" }
}

# =============================================================================
# Internet Gateway —— 互联网网关
# =============================================================================
# IGW 是 VPC 访问互联网的"门"。一个 VPC 只能绑定一个 IGW。
# 没有 IGW 的 VPC = 完全隔离的内部网络（也叫 Closed VPC）。
#
# 数据流向：
#   EC2 → 公有子网路由表（0.0.0.0/0 → IGW）→ Internet Gateway → 互联网
#   互联网 → Internet Gateway → NAT 转换（公网 IP → 私有 IP）→ EC2
# =============================================================================
resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.main.id
  tags = { Name = "smart-invest-igw" }
}

# =============================================================================
# 公有路由表 —— 定义公有子网的流量规则
# =============================================================================
# 路由表类似家用路由器里的路由规则表，决定不同目标 IP 的流量走哪条路。
#
# 关键路由规则解读：
#   0.0.0.0/0 → Internet Gateway
#   意思是：所有去往互联网的流量（0.0.0.0/0 匹配所有 IP），都走 Internet Gateway。
#   这就是"公有子网"之所以"公有"的原因——有到互联网的路由。
#
# 每个 VPC 有一个默认路由表（隐含路由：VPC 内部互通，不需要显式配置）。
# =============================================================================
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id
  route {
    cidr_block = "0.0.0.0/0"              # 目标：所有 IP 地址
    gateway_id = aws_internet_gateway.igw.id # 下一跳：Internet Gateway
  }
}

# =============================================================================
# 路由表关联 —— 将路由表绑定到子网
# =============================================================================
# 一个子网只能关联一个路由表，一个路由表可以关联多个子网。
# 所有公有子网通常共享同一个路由表（有到 IGW 的路由）。
# 私有子网可以使用独立路由表（没有 IGW，或只有 NAT Gateway）。
# =============================================================================
resource "aws_route_table_association" "public" {
  subnet_id      = aws_subnet.public.id
  route_table_id = aws_route_table.public.id
}

# =============================================================================
# EC2 安全组 —— 应用服务器的虚拟防火墙
# =============================================================================
# 安全组（Security Group）是 EC2 实例级别的防火墙，控制进出流量。
#
# 安全组特性：
#   - Stateful（有状态）：允许进就自动允许对应的出（不需要配出站规则）
#   - 默认 DENY：没有显式允许的流量一律拒绝
#   - 白名单模式：只配允许（Allow）规则，没有拒绝（Deny）规则
#   - 可以引用其他安全组：如下面 RDS 安全组引用 EC2 安全组
#
# 规则解读：
#   ingress (入站)规则：
#     - 443 (HTTPS): 允许全网访问（应用对外暴露的 HTTPS 端口）
#     - 22 (SSH):   仅允许管理员 IP（admin_cidr）访问，最严格的限制
#   egress (出站)规则：
#     - 全部端口 (0-65535): 允许访问任何地址（EC2 需要访问 RDS、S3 等）
# =============================================================================
resource "aws_security_group" "ec2" {
  name   = "smart-invest-ec2-sg"
  vpc_id = aws_vpc.main.id

  # -------------------------------------------------------------------
  # 入站规则 1: HTTPS (443)
  # Spring Boot 应用对外暴露的端口（配置了 SSL 的情况下）
  # 0.0.0.0/0 = 允许任何 IP 访问（应用是公开服务）
  # -------------------------------------------------------------------
  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # -------------------------------------------------------------------
  # 入站规则 2: SSH (22)
  # 仅允许管理员 IP 登录（安全最佳实践：绝不开放 22 端口给全网）
  # admin_cidr 格式如 "1.2.3.4/32"（精确匹配单个 IP）
  # -------------------------------------------------------------------
  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.admin_cidr]
  }

  # -------------------------------------------------------------------
  # 出站规则: 允许所有出站流量
  # -1 协议表示"所有协议"（TCP + UDP + ICMP 等）
  # 需要访问 RDS (5432)、Secrets Manager (443)、S3 (443)、下载依赖等
  # -------------------------------------------------------------------
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"               # -1 = 所有协议（TCP/UDP/ICMP...）
    cidr_blocks = ["0.0.0.0/0"]
  }
}

# =============================================================================
# RDS 安全组 —— 数据库的虚拟防火墙
# =============================================================================
# RDS 安全组只允许来自 EC2 安全组的 PostgreSQL 连接（5432 端口）。
#
# 安全组引用（security_groups 参数）：
#   这是一种强大的 AWS 安全机制 —— 不用 IP 地址，而是引用"谁可以访问我"。
#   只要 EC2 的安全组没变，RDS 规则就自动生效。
#
# 为什么不用 IP？
#   1. EC2 的私有 IP 会在重启后变化
#   2. 安全组引用是声明式的，"允许所有带这个安全组的实例"
#   3. Auto Scaling 场景下新实例自动获得访问权限
#
# 注意：这个安全组只定义了入站规则，没有 egress 块。
# 但安全组是 stateful 的——允许了入站流量，对应的出站响应会自动放行。
# =============================================================================
resource "aws_security_group" "rds" {
  name   = "smart-invest-rds-sg"
  vpc_id = aws_vpc.main.id
  ingress {
    from_port       = 5432              # PostgreSQL 默认端口
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.ec2.id]   # 只允许 EC2 安全组访问（不是 IP！）
  }
}
