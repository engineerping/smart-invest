# =============================================================================
# S3 + CloudFront 模块变量定义
# =============================================================================

# -------------------------------------------------------------------
# account_id: AWS 账号 ID（12 位数字）
# 用于构造 S3 Bucket 名称。因为 S3 Bucket 名称必须全局唯一，
# 加入 account_id 可以避免和其他用户/账号的 Bucket 名称冲突。
#
# 获取方式：
#   aws sts get-caller-identity --query Account --output text
#
# 示例：account_id = "123456789012"
#       → bucket = "smart-invest-frontend-123456789012"
# -------------------------------------------------------------------
variable "account_id" {}
