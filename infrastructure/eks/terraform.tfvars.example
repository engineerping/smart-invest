# =============================================================================
# 环境变量配置文件示例
# =============================================================================
# 复制这个文件为 terraform.tfvars 然后根据实际环境修改

# --- AWS ---
aws_region  = "ap-southeast-1"
dr_region   = "ap-southeast-3"
account_id  = "123456789012"

# --- 环境 ---
environment  = "dev"  # 可选值: dev, uat, prd
project_name = "smart-invest"

# --- 网络 ---
vpc_cidr = "10.0.0.0/16"

# --- 域名 ---
domain_name     = "smart-invest.example.com"
route53_zone_id = "Z0123456ABCDEF"  # Route53 托管区域 ID（如果没有就留空）

# --- EKS ---
eks_cluster_version = "1.29"

# --- 管理员 IP ---
admin_cidr_blocks = ["203.0.113.0/24"]  # 请改为公司 VPN 出口 IP
