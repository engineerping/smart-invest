# =============================================================================
# 根模块变量定义
# =============================================================================
# 变量是 Terraform 模块的"输入参数"，类比 Java 方法的形参。
# 变量值可以从多个来源获取（优先级从高到低）：
#   1. 命令行 -var / -var-file     → terraform apply -var="region=us-west-2"
#   2. *.auto.tfvars / *.auto.tfvars.json → 自动加载的变量文件
#   3. terraform.tfvars             → 默认变量文件
#   4. 环境变量 TF_VAR_<name>      → export TF_VAR_aws_region=us-west-2
#   5. default 值                   → variable 定义中的 default
#
# 最佳实践：
#   - 敏感变量不加 default，强制调用方显式传入
#   - 非敏感变量可以给合理的 default，降低使用门槛
# =============================================================================

# -------------------------------------------------------------------
# aws_region: AWS 区域
# 决定所有资源创建在哪个地理区域。us-east-1（弗吉尼亚）是 AWS 最老最全的区域，
# 服务最丰富、价格最低，是默认首选。
# -------------------------------------------------------------------
variable "aws_region"   { default = "us-east-1" }

# -------------------------------------------------------------------
# environment: 部署环境标识
# 用于区分 prod / staging / dev 等环境，可配合 Terraform workspaces 使用
# -------------------------------------------------------------------
variable "environment"  { default = "prod" }

# -------------------------------------------------------------------
# admin_cidr: 管理员 IP 地址（CIDR 格式）
# 用于 SSH（端口 22）安全组白名单，只允许指定 IP 登录 EC2。
# 格式：<你的公网 IP>/32，例如 "1.2.3.4/32"
# /32 表示精确匹配单个 IP，是最严格的限制。
#
# 安全最佳实践：绝不使用 0.0.0.0/0（全网开放），必须限制为自己 IP。
# -------------------------------------------------------------------
variable "admin_cidr"   { description = "Your IP in CIDR format, e.g. 1.2.3.4/32" }

# -------------------------------------------------------------------
# key_pair_name: EC2 SSH 密钥对名称
# 需要在 AWS Console → EC2 → Key Pairs 中预先创建。
# Terraform 不管理密钥对本身（出于安全考虑），只引用已有密钥对的名称。
# 创建命令：aws ec2 create-key-pair --key-name <name> --output text > key.pem
# -------------------------------------------------------------------
variable "key_pair_name"{ description = "EC2 SSH key pair name (created in AWS console)" }

# -------------------------------------------------------------------
# account_id: AWS 账号 ID（12 位数字）
# 用于构造 S3 bucket 名称（bucket 名称必须全局唯一，加入 account_id 避免冲突）。
# 可以通过 aws sts get-caller-identity 查询当前账号 ID。
# -------------------------------------------------------------------
variable "account_id"   { description = "AWS account ID" }
