# ==============================================================================
# Terraform Variable Definitions —— 生产环境变量值
# ==============================================================================
# 注意：
#   - terraform.tfvars.example → Git 跟踪（放示例值，不要放真实密码）
#   - terraform.tfvars         → Git 忽略（放真值）
#
# 使用方式：
#   1. cp terraform.tfvars.example terraform.tfvars
#   2. 编辑 terraform.tfvars，填入真实值
#   3. terraform plan / apply
# ==============================================================================

# ─── AWS 认证配置 ───
aws_profile = "default"                        # 使用 ~/.aws/credentials 中的 [default] profile
aws_region  = "ap-southeast-1"                 # AWS 新加坡区域（离国内近，延迟低）

# ─── 项目配置 ───
project_name = "smart-invest"
environment  = "prod"

# ─── EC2 实例配置 ───
# K3S + 6 个微服务 + RabbitMQ + Postgres 的单节点部署最低配置
instance_type   = "t3.medium"                  # 2 vCPU, 4 GB 内存（K3S 建议至少这个规格）
ebs_volume_size = 20                           # 20 GB gp3 SSD（给 Docker 镜像留空间）
key_pair_name   = "smart-invest-ec2-keypair"   # ⚠️ 改为你在 AWS 创建的 Key Pair 名称

# ─── S3 / CloudFront 配置 ───
# ⚠️ S3 存储桶名称必须全局唯一！建议格式：项目名-用途-唯一后缀
s3_bucket_name = "smart-invest-frontend-service-prod-bucket-name"

# ─── 安全配置 ───
# ⚠️ 生产环境强烈建议改为你的固定 IP！用 curl ifconfig.me 查看当前 IP
admin_cidr = "0.0.0.0/0"
