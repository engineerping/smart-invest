# ==============================================================================
# Networking 模块 —— VPC + 安全组（网络基础设施）
# ==============================================================================
#
# 一句话理解：
#   这 个 模 块 为 你 的 服 务 在 AWS 上 创 建 一 个 "网 络 围 墙"，
#   定 义 哪 些 流 量 能 进 来、哪 些 流 量 能 出 去。
#
# ==============================================================================
# K3S 架构说明（为什么这个模块很简单）
# ==============================================================================
# 本项目用的是「单 EC2 跑 K3S」架构，所有中间件（Postgres、RabbitMQ）
# 都 用 Docker 跑 在 同 一 台 EC2 上，不 用 RDS、不 用 ALB。
#
# 所以这个模块只需要：
#   1. 查询已有默认 VPC（不创建新 VPC）
#   2. 查询已有子网（直接用已有的）
#   3. 创建一个安全组（防火墙规则）
#
# 不用创建新的 VPC / 子网 / NAT 网关 / Internet Gateway，
# 这些都直接用 AWS 账号里已有的默认 VPC 即可。
#
# ==============================================================================
# 安全组 vs NACL 的区别
# ==============================================================================
# ┌──────────────┬──────────────────────┬──────────────────────┐
# │ 特性         │ Security Group       │ Network ACL          │
# ├──────────────┼──────────────────────┼──────────────────────┤
# │ 作用范围     │ 实例级别              │ 子网级别             │
# │ 状态         │ 有状态（回包自动放行）│ 无状态（回包要单独配）│
# │ 规则类型     │ 只有 allow           │ allow + deny         │
# │ 优先级       │ 所有规则平等          │ 按编号顺序           │
# │ 类比         │ 每个 EC2 的门禁      │ 子网的围墙           │
# └──────────────┴──────────────────────┴──────────────────────┘
#
# 一句话：Security Group 管"这台机器能收什么流量"，
#         NACL 管"这个子网能收什么流量"。
#         绝大多数场景只需要配置 Security Group。
# ==============================================================================

# ==============================================================================
# 数据源：查询 AWS 账号的默认 VPC
# ==============================================================================
# data 块不创建资源，只是"查询已有的信息"。
# 这里查询 AWS 账号中标记为 default = true 的 VPC。
# 每个 AWS 账号在新区域注册时，AWS 都会自动创建一个默认 VPC，
# 包含默认子网、Internet Gateway 等基本网络设施。
#
# 引用方式：data.aws_vpc.default.id → vpc-xxxxx
# ==============================================================================
data "aws_vpc" "default" {
  default = true # 只查"默认 VPC"（每个区域都有的那个）
}

# ==============================================================================
# 数据源：查询已有的子网
# ==============================================================================
# 这里直接用已有的子网 ID（来自 aws-infra-reflect 中的现网配置）。
# 如果你之后换了子网，改这个 ID 就行。
#
# 子网是什么？
#   子网 = VPC 的"分区"，每个子网属于一个可用区（AZ）。
#   一个 VPC 可以有多个子网，每个子网有自己的 CIDR（IP 范围）。
#
#   公有子网 vs 私有子网：
#   - 公有子网：路由表里有指向 Internet Gateway 的路由 → 可以直接访问互联网
#   - 私有子网：路由表里没有指向 Internet Gateway 的路由 → 不能直接上外网
#     如果需要上外网（如下载依赖），需要 NAT 网关
#
#   本项目 EC2 放在公有子网，因为需要公网 IP 供 CloudFront 访问。
# ==============================================================================
data "aws_subnet" "public" {
  id = "subnet-09d50013c6f6a2606" # TODO: 替换为你实际使用的 subnet ID
}

# ==============================================================================
# 数据源：查询默认 Internet Gateway
# ==============================================================================
# Internet Gateway（IGW）是 VPC 的"外网出口"。
# 没有 IGW，VPC 里的资源就无法访问互联网。
# 默认 VPC 自带一个 IGW，这里查询它的 ID。
# ==============================================================================
data "aws_internet_gateway" "default" {
  filter {
    name   = "attachment.vpc-id"
    values = [data.aws_vpc.default.id] # 只查绑定到默认 VPC 的 IGW
  }
}

# ==============================================================================
# 安全组 —— EC2 的"状态感知防火墙"
# ==============================================================================
# 安全组相当于 EC2 实例的防火墙，控制哪些流量可以进出实例。
#
# 关键概念：安全组是「有状态」的
#   意思是：如果你允许一个入站请求，它对应的出站响应会自动被允许，
#   不需要单独配一条 outbound 规则。类比：你家大门 —— 客人进来了，
#   出去不需要再刷卡。
#
# 安全组的两个方向：
#   - ingress（入站）：从外部 → EC2 的流量
#   - egress（出站）：从 EC2 → 外部的流量
#
# 每条规则包含：
#   - from_port / to_port：端口范围（一个端口就写两次，如 8080~8080）
#   - protocol：协议（tcp / udp / -1 表示所有）
#   - cidr_blocks：来源/目标 IP 段（0.0.0.0/0 = 全互联网）
# ==============================================================================
resource "aws_security_group" "smart_invest" {
  name        = "${var.project_name}-security-group"
  description = "Smart Invest backend security group "
  vpc_id      = data.aws_vpc.default.id

  # ─── 规则 1：应用端口 8080（CloudFront 回源）───
  ingress {
    description = "the request from cloudFront"
    from_port   = 8080
    to_port     = 8080
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # ─── 规则 2：SSH（22 端口）───
  ingress {
    description = "Any IP for github actions to connect"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # ─── 规则 3：K3s Kubernetes API（6443 端口）───
  # kubectl 通过这个端口与 K3s API Server 通信。
  ingress {
    description = "K3s Kubernetes API server"
    from_port   = 6443
    to_port     = 6443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # ─── 出站规则（Egress）───
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name    = "${var.project_name}-security-group"
    Project = var.project_name
  }
  lifecycle { create_before_destroy = true }
  revoke_rules_on_delete = false
}
