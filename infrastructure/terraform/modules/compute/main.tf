# ==============================================================================
# Compute 模块 —— EC2 实例（K3S 运行的计算节点）
# ==============================================================================
#
# 一句话理解：
#   这 个 模 块 创 建 一 台 EC2 虚 拟 机，K3S 和 所 有 微 服 务 都 跑 在 这 台 机 器 上。
#
# ==============================================================================
# 架构说明 —— 为什么只用一台 EC2
# ==============================================================================
# 本项目的部署架构是「单 EC2 + K3S」:
#
#                            ┌─────────────────────────────────┐
#                            │          EC2 (t3.medium)         │
#                            │   ┌───────────────────────────┐  │
#                            │   │  K3S (轻量 Kubernetes)      │  │
#                            │   │  ┌───────┐ ┌───────┐      │  │
#                            │   │  │user   │ │fund   │ ...  │  │
#                            │   │  │svc    │ │svc    │      │  │
#                            │   │  └───────┘ └───────┘      │  │
#                            │   │  ┌──────────┐              │  │
#                            │   │  │RabbitMQ  │              │  │
#                            │   │  └──────────┘              │  │
#                            │   └───────────────────────────┘  │
#                            │   ┌───────────────────────────┐  │
#                            │   │  Docker: Postgres + Redis   │  │
#                            │   └───────────────────────────┘  │
#                            └─────────────────────────────────┘
#
# 这种架构适合：
#   - 学习/演示环境（成本低，一台机器跑一切）
#   - 小型项目（流量不大，不需要多节点）
#   - 快速原型验证
#
# 不适合：
#   - 生产环境（单点故障 → 这台机器挂了，整个服务全挂）
#   - 高并发场景（单机 CPU/内存有限）
#   - 需要多可用区容灾的场景
#
# ==============================================================================
# EC2 实例类型选择指南
# ==============================================================================
# ┌─────────────┬──────────┬───────────┬──────────────────────┐
# │ 类型        │ vCPU     │ 内存      │ 适用场景             │
# ├─────────────┼──────────┼───────────┼──────────────────────┤
# │ t3.micro    │ 2        │ 1 GB      │ 不够跑 K3S + 多微服务│
# │ t3.small    │ 2        │ 2 GB      │ 勉强够（最低配置）   │
# │ t3.medium   │ 2        │ 4 GB      │ ★ 推荐（有余量）     │
# │ t3.large    │ 2        │ 8 GB      │ 更舒适（多跑几个服务）│
# └─────────────┴──────────┴───────────┴──────────────────────┘
#
# T 系列 = 可突发性能实例（Burstable）
#   CPU 积分机制：低负载时积累 CPU 积分，高负载时可以超用 CPU（消耗积分）。
#   积分用完 → CPU 被限制到 baseline 性能。适合 Web 应用这种大部分时间低负载、
#   偶尔有流量高峰的场景。
#   对于持续高 CPU 的任务（视频转码、ML 训练），T 系列不适合——改用 C 或 M 系列。
# ==============================================================================

# ==============================================================================
# 数据源：最新的 Amazon Linux 2023 AMI
# ==============================================================================
# AMI（Amazon Machine Image）= 操作系统安装镜像。
# Amazon Linux 2023 是 AWS 官方维护的 Linux 发行版，基于 Fedora，
# 预装了 AWS CLI、SSM Agent、cloud-init 等工具。
#
# 为什么用 data 查询而不是硬编码 AMI ID：
#   1. AMI ID 是区域相关的（us-east-1 和 ap-southeast-1 的不同）
#   2. AWS 会持续发布更新，安全补丁日新月异
#   3. 用 most_recent = true 永远拿最新安全更新的镜像
# ==============================================================================
data "aws_ami" "al2023" {
  most_recent = true                # 多个符合条件的 AMI 时，取最新的
  owners      = ["amazon"]         # 只看 AWS 官方发布的 AMI（第三方的不安全）

  filter {
    name   = "name"
    values = ["al2023-ami-*-x86_64"] # Amazon Linux 2023, x86_64 架构
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]                 # HVM = 硬件辅助虚拟化（现代标准）
  }
}

# ==============================================================================
# EC2 实例 —— 你的 K3S 服务器
# ==============================================================================
# EC2（Elastic Compute Cloud）= AWS 上的虚拟机。
# 每个参数的含义和选择理由见下方注释。
# ==============================================================================
resource "aws_instance" "k3s_server" {
  # ─── AMI：操作系统镜像 ───
  # 使用上面 data 查询到的最新 Amazon Linux 2023
  ami = data.aws_ami.al2023.id

  # ─── instance_type：硬件规格 ───
  # 用变量控制，可以在 terraform.tfvars 中轻松改配置而不改代码。
  # 这是个好习惯：把"容易变的值"抽成变量。
  instance_type = var.instance_type

  # ─── subnet_id：放在哪个子网 ───
  # 引用 networking 模块输出的公有子网 ID
  subnet_id = var.public_subnet_id

  # ─── vpc_security_group_ids：防火墙规则 ───
  # 引用 networking 模块创建的安全组
  vpc_security_group_ids = [var.security_group_id]

  # ─── iam_instance_profile：IAM 角色 ───
  # EC2 通过这个角色获得访问 AWS 其他服务（S3、CloudWatch 等）的权限，
  # 不需要在代码里配置 Access Key。这是 AWS 安全最佳实践。
  iam_instance_profile = var.instance_profile_name

  # ─── key_name：SSH 密钥对 ───
  # 用于 SSH 登录（ssh -i key.pem ec2-user@<public_ip>）
  # 需要先在 AWS 控制台 EC2 → Key Pairs 中创建
  key_name = var.key_pair_name

  # ─── associate_public_ip_address：自动分配公网 IP ───
  # EC2 启动后 AWS 会自动分配一个公网 IP（重启会变，见下面的 EIP）
  associate_public_ip_address = true

  # ══════════════════════════════════════════════════════════════════════
  # 系统盘（Root Block Device）配置
  # ══════════════════════════════════════════════════════════════════════
  # 这是 EC2 的操作系统盘（类似你电脑的 C 盘）。
  #
  # gp3 vs gp2 vs io1 的区别：
  #   gp3: 新一代通用 SSD，3000 IOPS + 125MB/s 作为基线（与容量无关），便宜
  #   gp2: 上代通用 SSD，IOPS 随容量增长（100GB 才有 300 IOPS）
  #   io1/io2: 高性能 SSD，支持独立配置 IOPS（贵，仅数据库等特殊场景用）
  #
  # 选择 gp3 的原因：便宜+基线性能好。
  #
  # delete_on_termination = true：实例销毁时自动删盘（避免残留的盘继续扣费）
  root_block_device {
    volume_type           = "gp3"
    volume_size           = var.ebs_volume_size # 由变量控制（建议至少 20GB）
    iops                  = 3000                # gp3 默认 3000 IOPS
    throughput             = 125                # gp3 默认 125 MB/s
    delete_on_termination = true
  }

  # ══════════════════════════════════════════════════════════════════════
  # 标签 —— 在 AWS 控制台中识别资源的元数据
  # ══════════════════════════════════════════════════════════════════════
  tags = {
    Name    = "${var.project_name}-k3s-server" # 控制台显示的名称
    Project = var.project_name
    Role    = "k3s-server"                   # 自定义标签：标识角色
  }

  # ══════════════════════════════════════════════════════════════════════
  # 生命周期配置 —— 防止误操作
  # ══════════════════════════════════════════════════════════════════════
  # ignore_changes = [ami] 的作用：
  #   当 AMI 有新版本发布，Terraform 不会自动去重建 EC2（重建 = 数据全丢！）。
  #   安全员告诉你"要更新 AMI"时，你再手动升级。
  lifecycle {
    ignore_changes = [ami] # 不要因为 AMI 更新就重建我的服务器！
  }
}

# ==============================================================================
# 弹性 IP（EIP）—— 固定的公网 IPv4 地址
# ==============================================================================
# 为什么需要 EIP：
#   EC2 的默认公网 IP 在「停止→启动」后会改变。
#   EIP 是固定的，绑定后即使重启实例，IP 也不变。
#   这对配置 DNS 记录和 CloudFront origin 很重要 ——
#   你不想每次重启 EC2 都得去改 DNS 和 CloudFront 配置。
#
# EIP 计费规则（重要！别被意外扣费）：
#   - 绑定到「运行中」的 EC2：免费（每账号限 1 个免费 EIP）
#   - 未绑定（闲置）：按小时收费（防止囤积 IP 不用的行为）
#   - 绑定到「已停止」的 EC2：按小时收费
#   所以：不用就删，不要留闲置的 EIP！
# ==============================================================================
resource "aws_eip" "k3s" {
  instance = aws_instance.k3s_server.id # 绑定到刚创建的 EC2
  domain   = "vpc"                      # VPC 类型的 EIP（现代标准）
}
