# =============================================================================
# Terraform & Provider 配置
# =============================================================================
# Terraform 是一种 Infrastructure as Code (IaC) 工具，由 HashiCorp 开发。
# 核心理念：用声明式语言描述基础设施的"期望状态"，Terraform 负责计算差异并执行变更。
#
# 三个核心概念：
#   1. Provider（提供者）—— 对接具体平台的"驱动"，如 AWS / Azure / GCP / K8S
#   2. Resource（资源） —— 你要管理的具体对象，如 EC2 实例、RDS 数据库
#   3. State（状态）   —— terraform.tfstate 文件，记录"实际状态 vs 期望状态"的映射
#
# 工作流程：terraform init → plan（预览变更）→ apply（执行变更）
# =============================================================================

# =============================================================================
# Terraform 语法速查：顶级配置块
# =============================================================================
# 三个核心块的区别：
#
# terraform { ... }
#   - 配置块（不是 resource/data/module），用于定义 Terraform 本身的设置
#   - 内容：required_version（版本约束）、required_providers（依赖声明）、backend（状态存储）
#   - 类比：build.gradle / pom.xml 中的配置声明部分
#
# provider "<提供者>" { ... }
#   - Provider 配置块，告诉 Terraform 如何连接目标平台
#   - 例如 provider "aws" = 配置 AWS 连接（region、认证方式等）
#   - 类比：数据库连接配置（JDBC URL、用户名、密码）
#
# resource "<类型>" "<名称>" { ... }
#   - 资源块，声明要创建/管理的基础设施对象
#   - 类比：new 一个对象并设置属性
# =============================================================================

terraform {
  # -------------------------------------------------------------------
  # required_version: 限制 Terraform 核心版本
  # >= 1.9 表示至少需要 1.9.x 版本，保证语法和功能兼容
  # -------------------------------------------------------------------
  required_version = ">= 1.9"

  # -------------------------------------------------------------------
  # required_providers: 声明本项目依赖的 Provider
  # 类比 Java 的依赖管理（Maven/Gradle），这里声明需要哪个 Provider、什么版本
  # -------------------------------------------------------------------
  required_providers {
    # AWS Provider —— 用于管理 AWS 云资源（EC2/RDS/VPC/S3/CloudFront/IAM 等）
    aws = {
      source  = "hashicorp/aws"   # Provider 来源：HashiCorp 官方仓库
      version = "~> 5.0"          # 悲观版本约束：>= 5.0 且 < 6.0，允许小版本自动升级
    }
  }
}

# =============================================================================
# Provider "aws" —— 配置 AWS 连接
# =============================================================================
# Provider block 告诉 Terraform 如何连接目标平台。
# AWS Provider 支持多种认证方式（优先级从高到低）：
#   1. 静态凭证：access_key / secret_key 直接写在 provider 里（不推荐）
#   2. 环境变量：AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
#   3. 共享凭证文件：~/.aws/credentials（AWS CLI 配置的）
#   4. IAM 角色：EC2 实例上自动获取（最安全，生产推荐）
#
# 这里只指定 region，认证方式由环境变量或 ~/.aws 配置提供。
# =============================================================================
provider "aws" {
  region = var.aws_region   # 引用变量，默认 us-east-1
}
