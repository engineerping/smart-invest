<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        =============================================================================
        Smart Invest 父 POM —— 统一管理所有微服务的依赖版本
        =============================================================================
        类比：这是一个 Maven "聚合 + 继承" 的根工程。
          - <modules> 聚合了所有子服务，一条 mvn 命令就能一起构建
          - 每个子服务 <parent> 指向这里，继承统一的依赖/插件/属性

        服务的依赖只声明在各自 pom 里，这里只做"版本管理"（dependencyManagement），
        不实际引入依赖，避免每个服务都打包一堆用不到的 jar。
        =============================================================================
    -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <groupId>com.smartinvest</groupId>
    <artifactId>smart-invest-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Smart Invest Parent</name>
    <description>Parent POM for Smart Invest microservices</description>

    <!-- 所有模块：共享库 + 4 个业务服务 + API 网关 -->
    <modules>
        <module>common</module>
        <module>user-service</module>
        <module>fund-service</module>
        <module>order-service</module>
        <module>notification-worker</module>
        <module>api-gateway</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 统一第三方库版本，避免各服务版本不一致 -->
        <lombok.version>1.18.36</lombok.version>
        <jjwt.version>0.12.6</jjwt.version>
        <spring-cloud.version>2023.0.3</spring-cloud.version>
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <!--
        dependencyManagement 只声明版本号，不引入依赖。
        子服务在 <dependencies> 里引用某个 artifact 时，会自动采用这里的版本。
    -->
    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud 统一版本管理（api-gateway 用） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- JWT 三件套 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- 内部共享模块 common -->
            <dependency>
                <groupId>com.smartinvest</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        所有子模块共享的依赖：Lombok。
        每个模块编译都需要 Lombok（生成 getter/setter），
        所以放在父 POM 的 <dependencies> 里，子模块自动继承。
    -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    父工程默认让 spring-boot 插件跳过打包，
                    只有真正的可执行服务（带 main 的）在各自 pom 里覆盖为 skip=false。
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
                <!--
                    关键：声明 Lombok 注解处理器。
                    如果缺失，@Getter/@Setter/@RequiredArgsConstructor 等注解
                    不会生成代码，编译直接报"找不到方法"。
                    annotationProcessorPaths 是编译期把注解转成字节码的"编译插件"。
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
